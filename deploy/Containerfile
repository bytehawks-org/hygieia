FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p hygeia

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/hygeia /usr/local/bin/hygeia
# api 8080/tcp, dns 5353/udp (override via hygeia.toml, mount at /etc/hygeia/hygeia.toml)
EXPOSE 8080/tcp 5353/udp
ENTRYPOINT ["/usr/local/bin/hygeia"]
